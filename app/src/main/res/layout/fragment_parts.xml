<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="🔩 PARTS INVENTORY"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Filter by type and status"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

        <!-- Type Filter Chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:checked="true"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/dark_surface_variant"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/accent_cyan"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBolt"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bolt"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/dark_surface_variant"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/accent_cyan"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNut"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nut"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/dark_surface_variant"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/accent_cyan"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGear"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gear"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/dark_surface_variant"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/accent_cyan"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipScrew"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screw"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/dark_surface_variant"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/accent_cyan"
                app:chipStrokeWidth="0dp" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Status Filter Chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Status"
                android:checked="true"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/dark_surface_variant"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/accent_cyan"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGood"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ Good"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/dark_surface_variant"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/accent_green"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBad"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ Bad"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/dark_surface_variant"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/accent_red"
                app:chipStrokeWidth="0dp" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <!-- Results Count -->
    <TextView
        android:id="@+id/resultsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:text="0 results"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />

    <!-- Parts List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/partsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="40sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No parts found"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Scan items from the ESP32 to see them here"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
